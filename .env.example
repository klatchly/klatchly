# Klatchly configuration. Copy to .env next to compose.yml and fill in (docs/self-hosting.md).
# Never put a secret value here: secrets are files under secrets/ (0400, owned by KLATCHLY_UID), referenced by path.
# Host-specific additions (extra networks, services, secrets) go in compose.override.yml, not here.

# ── Required ──

# The exact public address of the app (scheme://host[:port], no path) and the WebAuthn RP ID: the origin's host or
# a parent domain of it. A passkey created for one RP ID does not work for another.
KLATCHLY_ORIGIN=https://klatchly.example.com
KLATCHLY_RP_ID=klatchly.example.com
# The Beeper token file (docs/beeper-server.md), readable by KLATCHLY_UID only.
BEEPER_TOKEN_PATH=./secrets/beeper-token

# ── Optional ──

# Compose project name (prefix of the volumes and networks).
COMPOSE_PROJECT_NAME=klatchly
# Time zone of both containers.
KLATCHLY_TZ=UTC
# uid/gid the containers run as and that owns their data: an otherwise unused uid on the host. Also build arguments:
# rebuild the images after changing them.
KLATCHLY_UID=10001
KLATCHLY_GID=10001
# Host port of klatchly, published on 127.0.0.1 only (point the reverse proxy or cloudflared at it).
KLATCHLY_PORT=8080
# Proxies (comma-separated CIDRs) whose client-IP header is believed. A proxy on the host reaches the container from
# the compose network's gateway: add it (docker network inspect <project>_default --format '{{json .IPAM.Config}}').
KLATCHLY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── Sign-in through an OIDC provider (optional) ──

# Next to the passkeys: "Continue with <label>" on the sign-in page; the provider decides how people authenticate.
# Empty issuer: off. At the provider, register the redirect URI KLATCHLY_ORIGIN + /api/auth/oidc/callback. Then pin your
# account: cli.js enroll, open /enroll, "Link a <label> account" (or KLATCHLY_OIDC_ALLOWED_SUB). docs/self-hosting.md.
KLATCHLY_OIDC_ISSUER=
KLATCHLY_OIDC_CLIENT_ID=
# A confidential client's secret, as a file mounted by compose.override.yml (empty: a public client, PKCE only).
KLATCHLY_OIDC_CLIENT_SECRET_FILE=
# Button label (empty: the issuer's host), scopes (empty: openid), a subject pinned here (the provider's sub, never
# an e-mail).
KLATCHLY_OIDC_LABEL=
KLATCHLY_OIDC_SCOPES=
KLATCHLY_OIDC_ALLOWED_SUB=

# ── Packages ──

# Packages built in, comma-separated ids (empty: the tree's default list, web/ext/packages.json). Rebuild after a change.
KLATCHLY_PACKAGES=
# llm + writing: the server's own LLM provider, OpenAI-compatible (more can be added in Settings). Leave the URL empty
# for none. With a URL, the model and the llm_key secret are required (docs/self-hosting.md).
KLATCHLY_LLM_URL=
KLATCHLY_LLM_MODEL=
# Default fallback model (optional).
KLATCHLY_LLM_FALLBACK=
# Who answers, shown in the privacy line of the writing menu: a name, or one per language ({"en": ...} required).
KLATCHLY_LLM_LABEL=
# transcribe: the server's own speech-to-text provider, NVIDIA's hosted Riva models (more can be added in Settings).
# The path, in the container, of its key file (a secret in compose.override.yml, e.g. /run/secrets/transcribe_nvidia_key;
# docs/self-hosting.md). Empty: none.
KLATCHLY_TRANSCRIBE_NVIDIA_KEY_FILE=
# Its model: whisper-large-v3 (default), parakeet-1.1b-rnnt-multilingual, canary-1b, parakeet-ctc-0.6b-vi, or an NVCF
# function id. Its language: empty for automatic detection (Whisper, Parakeet multilingual), else a code (fr-FR…).
KLATCHLY_TRANSCRIBE_NVIDIA_MODEL=
KLATCHLY_TRANSCRIBE_NVIDIA_LANGUAGE=
# agents: its manifest, a JSON file mounted read-only (path in the container, e.g. /config/agents.json; the volume
# in compose.override.yml; model: web/ext/agents/agents.example.json; docs/self-hosting.md "Agents manifest").
KLATCHLY_AGENTS_FILE=
# Without a manifest (or for one without "owner"): on whose behalf the agent writes (empty: the user's own name in
# the chat); without a manifest: where a chat's messages go at each call (every agent's privacy line).
KLATCHLY_AGENTS_OWNER_NAME=
KLATCHLY_AGENTS_LABEL=
